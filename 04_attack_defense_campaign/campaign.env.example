# Source this file after editing paths for the cluster.
export CAMPAIGN_ID=stealth_asr_defense_v1
export VENV_ACTIVATE=/path/to/venv/bin/activate
export SPIKE_RETIMING_REPO=/path/to/Spike-Retiming-Attacks
export PDSG_SDA_DIR=/path/to/PDSG_or_SDA_repo
export YAO_DIR=/path/to/Yao_Gumbel_repo

# Common attack settings
export NATIVE_COMPARE_BUDGET=0.10
export PRIOR_STEPS=40
export PRIOR_RECALIBRATE=1
export FREE_SWEEP_BUDGET=0.10
export FREE_SWEEP_MAX_SHIFTS=2,4,8,16,32
export DEFENSE_ANALYSIS=1
export REQUIRE_DISJOINT_CLEAN_POOL=1
export SAVE_PERTURBATIONS=1

# Optional Slurm flags, e.g. partition/QOS/account. Do NOT hard-code site-specific paths.
# export SBATCH_EXTRA_ARGS="--partition=<partition> --qos=<qos>"

# Portability / reliability
export FLUSH_EVERY=1
# Override on clusters that use a different Slurm GPU request syntax.
# export SBATCH_GPU_ARGS="--gpus=1"
# For local launcher: export GPU_LIST=0,1,2,3
